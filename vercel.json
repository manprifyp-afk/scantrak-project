{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "csas-backend": {
      "root": "csas-backend",
      "framework": "express"
    },
    "csas-frontend": {
      "root": "csas-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/csas-backend/api/$1" },
    { "source": "/(.*)", "destination": "/csas-frontend/$1" }
  ]
}